#API
GEMINI_API_KEY=api_key

#Embedding model
EMBEDDING_MODEL=models/gemini-embedding-001
MAX_CONSECUTIVE_404=5

#Erros
MAX_EMBEDDING_PER_MINUTE=50
EMBEDDING_BATCH_SIZE=20
MAX_429_RETRIES=6
SKIP_INGESTED=true

#DB
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password

#Ingestion
DATA_DIR=/data
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

TARGET_TABLE=document_chunks_v2
HEADER_ZONE_RATIO=0.14
FOOTER_ZONE_RATIO=0.92
